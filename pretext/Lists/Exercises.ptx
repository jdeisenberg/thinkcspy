  <exercise label="ex_list_implement_methods">
    <statement>
      <p>Although Python provides us with many list methods, it is good practice and very instructive to think about how they are implemented.  Implement Python functions that work like the following:</p>
      <p>
        <ol marker="a">
          <li>
            <p><c>count</c></p>
          </li>
          <li>
            <p><c>in</c> (you will have to name this function <c>is_in</c> because <c>in</c> is a reserved word)</p>
          </li>
          <li>
            <p><c>reverse</c></p>
          </li>
          <li>
            <p><c>index</c></p>
          </li>
          <li>
            <p><c>insert</c></p>
          </li>
        </ol>
      </p>
    </statement>
    <program interactive="activecode" language="python" xml:id="ex_list_implement_methods_editor">
      <code>
# Your functions go here..

a_list = [0, 1, 1, 2, 2, 3, 4, 5, 6, 7, 8, 9]
print(count(1, a_list))
print(is_in(4, a_list))
print(reverse(a_list))
print(index(2, a_list))
print(insert('cat', 4, a_list))
</code>
    </program>
    <solution>
      <program xml:id="ex_list_implement_methods_answer" language="python">
        <code>
def count(obj, a_list):
    count = 0
    for element in a_list:
        if element == obj:
            count = count + 1
    return count

def is_in(obj, a_list):  # cannot be called in() because in is a reserved keyword
    for element in a_list:
        if element == obj:
            return True
    return False

def reverse(a_list):
    reversed = []
    for i in range(len(a_list) - 1, -1, -1): # step through the original list backwards
        reversed.append(a_list[i])
    return reversed

def index(obj, a_list):
    for i in range(len(a_list)):
        if a_list[i] == obj:
            return i
    return -1

def insert(obj, index, a_list):
    new_list = []
    for i in range(len(a_list)):
        if i == index:
            new_list.append(obj)
        new_list.append(a_list[i])
    return new_list

a_list = [0, 1, 1, 2, 2, 3, 4, 5, 6, 7, 8, 9]
print(count(1, a_list))
print(is_in(4, a_list))
print(reverse(a_list))
print(index(2, a_list))
print(insert('cat', 4, a_list))
        </code>
      </program>
    </solution>
  </exercise>
  
