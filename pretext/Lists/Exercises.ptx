  <exercise label="ex_list_product_negatives">
    <statement>
      <p>Calculate the product of all the negative numbers in a list. For example, <c>product_negatives([-3, 2, -4, 7])</c> should be 12. If a list contains no negative numbers, return 1.</p>
    </statement>
    <program interactive="activecode" language="python" xml:id="ex_list_product_negatives_editor">
      <code>
def product_negatives(number_list):
    # your code here

  </code>
  <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testOne(self):
        self.assertEqual(product_negatives([-1, -2, -3, -4, -5]), -120, "Tested product_negatives on input [-1, -2, -3, -4, -5]")
        self.assertEqual(product_negatives([1, -3, 5, -7, 9]), 21, "Tested product_negatives on input [1, -3, 5, -7, 9]")
        self.assertEqual(product_negatives([-2, -4, 6, -7, 9]), -56, "Tested product_negatives on input [-2, -4, 6, -7, 9]")
        self.assertEqual(product_negatives([1, 2, 3, 4]), 1, "Tested product_negatives on input [1, 2, 3, 4]")

myTests().main()
        </tests>
    </program>
    <solution>
      <program xml:id="ex_list_product_negatives_answer" language="python">
        <code>
import random

def product_negatives(number_list):
    product = 1
    for element in number_list:
        if element &lt; 0:
            product = product * element
    return product

numbers = []
for i in range(10):
    numbers.append(random.randrange(-10, 10))

print(numbers) # show numbers
print(product_negatives(numbers))
        </code>
      </program>
    </solution>
  </exercise>
  
