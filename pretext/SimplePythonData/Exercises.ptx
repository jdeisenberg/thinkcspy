  <exercise label="ex_2_9">
    <statement>
      <p>Write a program that will compute the area of a rectangle.  Prompt the user to enter the width and height of the rectangle. The values can have decimal places (for example, a width of 7.25 and a height of 4.9). Print a nice message with the answer.</p>
    </statement>
    <program interactive="activecode" language="python" xml:id="ex_2_9_editor">
      <input>

        </input>
    </program>
    <solution>
      <program xml:id="spd_q9_answer" language="python">
        <input>
## rectangle area solution

width = float(input("Width? "))
height = float(input("Height? "))

area = width * height

print("The area of the rectangle is", area)
        </input>
      </program>
    </solution>
  </exercise>
