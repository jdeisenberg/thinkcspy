  <exercise label="e5mc12">
    <statement>
      <p>Which of the following will add up the numbers from 1 to 4?</p>
      <p>
        <ol marker="1">
          <li>
            <program language="python">
        <input>
for i in range(1,4):
    sum = 0
    sum = sum + i
</input>
      </program>
            </li>

          <li>
      <program language="python">
        <input>
sum = 0
for i in range(1,4):
    sum = sum + i
</input>
      </program>
    </li>
    
    <li>
      <program language="python">
        <input>
for i in range(1,5):
    sum = 0
    sum = sum + i
</input>
      </program>
    </li>
    
    <li>
      <program language="python">
        <input>
sum = 0
for i in range(1,5):
    sum = sum + sum
</input>
      </program>
    </li>
    
    <li>
      <program language="python">
        <input>
sum = 0
for i in range(1,5):
    sum = sum + i
</input>
      </program>
    </li>
  </ol>
  </p>
    </statement>
    <choices>
      <choice>
        <statement>
          <p>1.</p>
        </statement>
        <feedback>
          <p>This will loop from 1 to 3 and reset sum to 0 at the start of each iteration.</p>
        </feedback>
      </choice>
      <choice>
        <statement>
          <p>2.</p>
        </statement>
        <feedback>
          <p>This will loop from 1 to 3.</p>
        </feedback>
      </choice>
      <choice>
        <statement>
          <p>3.</p>
        </statement>
        <feedback>
          <p>This will loop from 1 to 4, but will reset the sum to 0 at the start of each iteration.</p>
        </feedback>
      </choice>
      <choice>
        <statement>
          <p>4.</p>
        </statement>
        <feedback>
          <p>This will loop from 1 to 4, but adds sum to itself.</p>
        </feedback>
      </choice>
      <choice correct="yes">
        <statement>
          <p>5.</p>
        </statement>
        <feedback>
          <p>This will loop from 1 to 4 and calculate the sum of those values.</p>
        </feedback>
      </choice>
    </choices>
  </exercise>
  
